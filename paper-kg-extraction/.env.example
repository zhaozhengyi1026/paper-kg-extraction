# 复制为 .env 后填写。默认 SenseNova 主抽取，LLM_* 模型作为 fallback。

# —— 主抽取：SenseNova ——
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
SENSENOVA_MODEL=sensenova-6.7-flash-lite

# 论文级并发；建议从 2 开始，遇到频繁 429 时调低。
EXTRACTION_WORKERS=2
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN=300

# NLI 默认 SenseNova 优先、下方 LLM_* DeepSeek fallback；如需独立主模型再设置 NLI_*。
# NLI_BASE_URL=https://token.sensenova.cn/v1
# NLI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# NLI_MODEL=sensenova-6.7-flash-lite

# —— Fallback：DeepSeek / NVIDIA NIM ——
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-ai/deepseek-v3

# —— 方案 B：OpenRouter ——
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-xxxx
# LLM_MODEL=deepseek/deepseek-chat

# —— 方案 C：本地 vLLM / Ollama（OpenAI 兼容端口）——
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# 抽取要确定性，温度固定 0（不要改大）
LLM_TEMPERATURE=0

# med-paper-collector 的 SQLite 库路径（--from db 时用；也可命令行 --db 指定）
PAPERS_DB=../paper-search-proxy_new_evidence/med-paper-collector/data/papers.db
