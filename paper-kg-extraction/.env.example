# 复制为 .env 后填写。默认 SenseNova 主抽取，LLM_* 模型作为 fallback。

# —— 主抽取：SenseNova ——
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
SENSENOVA_MODEL=sensenova-6.7-flash-lite
SENSENOVA_MIN_INTERVAL=0.2
SENSENOVA_MAX_COMPLETION_TOKENS=4096
EXTRACTION_PROVIDER=sensenova

# 论文级并发；200 篇测试默认使用 6，遇到频繁 429 时调低。
EXTRACTION_WORKERS=6
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN=300

# NLI 默认 SenseNova 优先、下方官方 DeepSeek fallback；如需独立主模型再设置 NLI_*。
# NLI_BASE_URL=https://token.sensenova.cn/v1
# NLI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# NLI_MODEL=sensenova-6.7-flash-lite

# —— Fallback：DeepSeek 官方 API ——
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MIN_INTERVAL=1.0
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING=enabled
DEEPSEEK_MAX_COMPLETION_TOKENS=4096
NLI_MAX_COMPLETION_TOKENS=512
NLI_MIN_INTERVAL=2.0

# —— 方案 B：OpenRouter ——
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-xxxx
# LLM_MODEL=deepseek/deepseek-chat

# —— 方案 C：本地 vLLM / Ollama（OpenAI 兼容端口）——
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# 兼容其他 OpenAI 风格模型时使用；DeepSeek 官方配置不读取这些变量。
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=unused
LLM_MODEL=unused

# 抽取要确定性，温度固定 0（不要改大）
LLM_TEMPERATURE=0

# med-paper-collector 的 SQLite 库路径（--from db 时用；也可命令行 --db 指定）
PAPERS_DB=../paper-search-proxy_new_evidence/med-paper-collector/data/papers.db
